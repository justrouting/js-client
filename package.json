{
  "name": "@justrouting/client",
  "version": "0.1.0",
  "description": "Official JavaScript client for the JustRouting API — routing, distance matrices, and vehicle routing optimization across Southeast Asia.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "routing",
    "osrm",
    "vroom",
    "matrix",
    "optimization",
    "logistics"
  ],
  "homepage": "https://justrouting.tech",
  "engines": {
    "node": ">=20.3"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
